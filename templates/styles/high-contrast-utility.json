{
  "id": "high-contrast-utility",
  "name": "High Contrast Utility",
  "intent": "Creates a direct, resilient interface that feels clear, durable, and immediately usable under pressure.",
  "worksFor": ["forms", "settings", "admin-tool", "checkout", "accessibility-first-product", "field-workflow"],
  "avoidFor": ["luxury-brand", "editorial-story", "immersive-marketing", "ambient-wellness", "playful-game-ui"],
  "color": {
    "chromaRange": { "min": 0.0, "max": 0.18 },
    "lightnessSpread": { "min": 0.55, "max": 0.98 },
    "hueRelationshipRules": ["monochrome", "complementary"],
    "surfaceCountLimit": 3,
    "saturatedBackgroundsPermitted": false
  },
  "type": {
    "scaleRatio": { "min": 1.125, "max": 1.2 },
    "weightRange": { "min": 450, "max": 800 },
    "trackingRules": ["zero-tracking-for-body", "strong-label-weight-before-tracking", "no-thin-type"],
    "maximumSimultaneousFamilies": 1,
    "caseTreatment": ["sentence", "numeric-tabular", "no-all-caps"]
  },
  "space": {
    "densityMultiplier": { "min": 0.9, "max": 1.2 },
    "whitespaceToContentRatioTarget": { "min": 0.28, "max": 0.46 }
  },
  "shape": {
    "radiusMultiplierRange": { "min": 0.25, "max": 1 },
    "borderWeightRange": { "min": 1.25, "max": 2.5 }
  },
  "depth": {
    "allowedElevationTechniques": ["border", "none"]
  },
  "motion": {
    "durationMultiplier": { "min": 0.5, "max": 0.9 },
    "permittedEasingFamilies": ["linear", "standard"]
  },
  "accessibilityWarnings": [],
  "fallbacks": [
    {
      "condition": "forced-colors-mode",
      "response": "Preserve hierarchy through system color roles, borders, outlines, and text labels rather than custom fills."
    }
  ],
  "prohibitions": [
    "no-hardcoded-hex-values",
    "no-fixed-pixel-layout-sizes",
    "no-subtle-muted-critical-text",
    "no-focus-ring-suppression",
    "no-color-only-feedback",
    "no-animation-required-for-comprehension"
  ],
  "constraints": {
    "mayNotRelax": ["contrast-gates", "touch-target-minimums", "focus-indicator-visibility", "reduced-motion-support", "text-expansion-40-percent"]
  }
}
