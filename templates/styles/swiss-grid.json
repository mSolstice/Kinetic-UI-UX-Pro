{
  "id": "swiss-grid",
  "name": "Swiss Grid",
  "intent": "Creates a precise, rational interface that feels ordered, legible, and quietly authoritative.",
  "worksFor": ["dashboard", "documentation", "pricing-page", "settings", "data-table", "product-site"],
  "avoidFor": ["playful-onboarding", "celebratory-marketing", "immersive-story", "youth-brand", "game-ui"],
  "color": {
    "chromaRange": { "min": 0.0, "max": 0.12 },
    "lightnessSpread": { "min": 0.45, "max": 0.94 },
    "hueRelationshipRules": ["monochrome", "analogous"],
    "surfaceCountLimit": 4,
    "saturatedBackgroundsPermitted": false
  },
  "type": {
    "scaleRatio": { "min": 1.125, "max": 1.25 },
    "weightRange": { "min": 400, "max": 700 },
    "trackingRules": ["zero-tracking-for-body", "consistent-label-tracking", "no-display-letterspacing-drama"],
    "maximumSimultaneousFamilies": 1,
    "caseTreatment": ["sentence", "numeric-tabular", "uppercase-labels-only"]
  },
  "space": {
    "densityMultiplier": { "min": 0.9, "max": 1.2 },
    "whitespaceToContentRatioTarget": { "min": 0.32, "max": 0.48 }
  },
  "shape": {
    "radiusMultiplierRange": { "min": 0, "max": 1 },
    "borderWeightRange": { "min": 1, "max": 1.5 }
  },
  "depth": {
    "allowedElevationTechniques": ["border", "none"]
  },
  "motion": {
    "durationMultiplier": { "min": 0.75, "max": 1 },
    "permittedEasingFamilies": ["standard", "decelerate"]
  },
  "accessibilityWarnings": [],
  "fallbacks": [],
  "prohibitions": [
    "no-hardcoded-hex-values",
    "no-fixed-pixel-layout-sizes",
    "no-centered-longform-body-copy",
    "no-asymmetric-spacing-that-breaks-grid-rhythm",
    "no-decorative-elevation"
  ],
  "constraints": {
    "mayNotRelax": ["contrast-gates", "touch-target-minimums", "focus-indicator-visibility", "reduced-motion-support", "text-expansion-40-percent"]
  }
}
